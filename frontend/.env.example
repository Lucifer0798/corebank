# Copy to .env.local (gitignored) to override. The defaults baked into src/auth/oidcConfig.ts
# and src/api/client.ts already match `docker compose up`, so this file is only needed if you
# are running the backend or Keycloak somewhere other than localhost.

VITE_OIDC_AUTHORITY=http://localhost:8081/realms/corebank
VITE_OIDC_CLIENT_ID=corebank-web
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_INSIGHTS_API_BASE_URL=http://localhost:8000/api/v1
